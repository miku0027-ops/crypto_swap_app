# Copy to .env.server for local development. Never commit real credentials.
# Node 24 is required. Production requires Firestore and explicit HTTPS origins.
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
APP_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
STORE_DRIVER=sqlite
DATABASE_PATH=./.data/hoplane.sqlite
FIREBASE_PROJECT_ID=hoplane-b9ac1

# Obtain your own Relay App key for quotes; keep it exclusively on the server.
RELAY_API_KEY=
RELAY_TIMEOUT_MS=10000
QUOTE_TTL_MS=30000
MAX_SLIPPAGE_BPS=300
SESSION_TTL_MS=86400000
AUTH_CHAIN_ID=1

# Disabled until provider credentials, route policies and end-to-end tests pass.
ENABLE_MAINNET=false
ENABLE_EXECUTION=false
# Candidate chains are intersected with current Relay EVM metadata at runtime.
# A chain ID here does not guarantee a supported route or available liquidity.
ALLOWED_MAINNET_CHAINS=1,8453,42161,10,137,56,43114,534352,324
ALLOWED_TESTNET_CHAINS=11155111,84532
# Operator-reviewed EVM contract targets per chain; no guessed addresses.
ALLOWED_TRANSACTION_TARGETS_JSON={}
# Server-owned RPC URLs per chain. Treat credential-bearing URLs as secrets.
RPC_URLS_JSON={}
# Keep zero locally. Set only for a verified production proxy topology.
TRUST_PROXY_HOPS=0
